+#[test]
+fn slc1_token_fields_use_the_slc1_names_and_twelve_bit_data() {
+    let cell = UnsafeCell::new(0x0abc_0000);
+    let reg = register::<slc::slc1token1::SLC1TOKEN1_SPEC>(&cell);
+    assert_eq!(reg.read().sdio_slc1_token1().bits(), 0xabc);
+    reg.write(|w| unsafe {
+        w.sdio_slc1_token1_wdata().bits(0xfff);
+        w.sdio_slc1_token1_wr().set_bit();
+        w.sdio_slc1_token1_inc().set_bit();
+        w.sdio_slc1_token1_inc_more().set_bit()
+    });
+    assert_eq!(reg.read().bits(), 0x7fff);
