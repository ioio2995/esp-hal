+#[test]
+fn slc0_token_write_data_has_twelve_bits() {
+    let cell = UnsafeCell::new(0);
+    let reg = register::<slc::slc0token1::SLC0TOKEN1_SPEC>(&cell);
+    reg.write(|w| unsafe {
+        w.sdio_slc0_token1_wdata()
+            .bits(0xfff)
