index 00000000..293fa0c5
--- /dev/null
+++ b/esp32c6/tests/slc_fields.rs
@@ -0,0 +1,58 @@
+//! Host-only bit-packing regressions. All registers below live in local RAM;
+//! no peripheral address is accessed and no DMA is emulated.
+use core::cell::UnsafeCell;
+
+use esp32c6::{
+    generic::{Reg, RegisterSpec},
+    slc,
+};
+
+fn register<REG: RegisterSpec<Ux = u32>>(cell: &UnsafeCell<u32>) -> &Reg<REG> {
+    assert_eq!(
+        core::mem::size_of::<Reg<REG>>(),
+        core::mem::size_of::<UnsafeCell<u32>>()
+    );
+    assert_eq!(
+        core::mem::align_of::<Reg<REG>>(),
+        core::mem::align_of::<UnsafeCell<u32>>()
+    );
+    // Reg and its VolatileCell are transparent wrappers around UnsafeCell<u32>.
+    // The returned reference borrows this local allocation, not a peripheral.
+    unsafe { &*(cell as *const UnsafeCell<u32>).cast::<Reg<REG>>() }
+}
+
+#[test]
+fn token_no_replace_uses_bit_zero_and_preserves_other_bits() {
+    let cell = UnsafeCell::new(0x0203_701a);
+    let reg = register::<slc::slc_rx_dscr_conf::SLC_RX_DSCR_CONF_SPEC>(&cell);
+    reg.modify(|_, w| w.sdio_slc0_token_no_replace().set_bit());
+    assert_eq!(reg.read().bits(), 0x0203_701b);
+    assert!(reg.read().sdio_slc0_token_no_replace().bit_is_set());
+}
